<launch>

    <include file="$(find abot_model)/launch/test.launch"/>

    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping"/>

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find abot_model)/rviz/gmapping.rviz"/>

    <node pkg="wpr_simulation" type="keyboard_vel_ctrl" name="keyboard_vel_ctrl"/>

</launch>